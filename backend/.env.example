# Copy to backend/.env and adjust. Used by Docker Compose (env_file) and local runs.
# Never commit backend/.env (real secrets).

NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27018/smart-menu
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AUTH_RATE_LIMIT_MAX=100
