# Copy to backend/.env and adjust. Used by Docker Compose (env_file) and local runs.
# Never commit backend/.env (real secrets).

NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27018/smart-menu
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AUTH_RATE_LIMIT_MAX=100

# Stripe Billing (optional — leave unset to disable paid checkout; webhook still returns 503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
# Optional overrides (defaults use FRONTEND_URL + paths)
STRIPE_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_PATH=/settings?billing=success
STRIPE_CHECKOUT_CANCEL_PATH=/settings?billing=canceled

# Days of full dashboard access after first failed invoice while Stripe subscription is past_due
SUBSCRIPTION_GRACE_DAYS=7
